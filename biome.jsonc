{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["eslint-config-heck/biomeJsTs", "eslint-config-heck/biomeComplexity"],
	"linter": {
		"rules": {
			"performance": {
				"noBarrelFile": "off"
			}
		}
	},
	"overrides": [
		{
			// Test files
			"includes": ["**/*.spec.ts", "**/*.spec.tsx", "**/test/**/*.ts", "**/test/**/*.tsx"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveNestedCallbacks": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		}
	],
	"formatter": {
		"enabled": true,
		"lineWidth": 130
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
